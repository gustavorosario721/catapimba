# The API queries with the authenticated user's JWT and a publishable key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional generative concierge: leave disabled until provider/budget is approved.
CONCIERGE_ENABLED=false
CONCIERGE_MODEL=
CONCIERGE_ALLOWED_ORIGIN=
# For local use only; production may use Vercel OIDC. Never use VITE_ here.
AI_GATEWAY_API_KEY=

# Exact frontend origins separated by commas. Never use a wildcard.
FRONTEND_ORIGINS=https://catapimba-mu.vercel.app
NODE_ENV=production
